{
  "name": "@rockhall/electron-offline-content-example-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local fixtures example (Electron Forge + React) for @rockhall/electron-offline-content",
  "main": ".vite/build/main.js",
  "scripts": {
    "predev": "node ../../scripts/ensure-root-package-built.mjs",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "lint": "oxlint --config .oxlintrc.json --react-plugin --node-plugin --deny-warnings .",
    "lint:fix": "oxlint --config .oxlintrc.json --react-plugin --node-plugin --fix --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run knip"
  },
  "dependencies": {
    "@rockhall/electron-offline-content": "../../",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^40.8.2",
    "esbuild": "^0.25.9",
    "knip": "^6.0.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.11"
  },
  "packageManager": "pnpm@11.1.0",
  "productName": "Offline Content Example (local)"
}
