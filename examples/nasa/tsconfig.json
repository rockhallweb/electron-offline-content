{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@rockhall/electron-offline-content/main": ["../../src/main/index.ts"],
      "@rockhall/electron-offline-content/preload": ["../../src/preload/index.ts"],
      "@rockhall/electron-offline-content/renderer": ["../../src/renderer/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "forge.config.ts", "forge.env.d.ts"]
}
