{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["src/**", "package.json", "pnpm-lock.yaml", "tsconfig.json", "tsup.config.ts"],
      "outputs": ["dist/**"]
    },
    "check": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "vitest.config.ts",
        "tsup.config.ts"
      ]
    },
    "lint": {},
    "format:check": {},
    "test": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "vitest.config.ts"
      ]
    },
    "test:smoke": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "vitest.config.ts"
      ]
    },
    "pack:verify": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
